# mock | live
NULIGA_MODE=mock

# Identifies your club within nuliga. Federation is the short code nuliga
# uses for your regional association (e.g. BAD for Badischer Tennisverband,
# WTB for Württembergischer Tennis-Bund) — check the "federation=" query
# param on your association's nuliga URLs. Club number is your club's
# nuliga "Vereinsnummer" (visible in the URL of your club's team-list page,
# e.g. .../clubTeams?club=12345).
NULIGA_FEDERATION=
NULIGA_CLUB_NR=
NULIGA_CLUB_NAME=

# Only required when NULIGA_MODE=live, provided by your association together
# with the nuPortalRS host for their federation (pattern seen elsewhere:
# https://<verband>-portal.liga.nu). See "Requesting API access" in the README.
NULIGA_HOST=
NULIGA_CLIENT_ID=
NULIGA_CLIENT_SECRET=

PORT=8787
